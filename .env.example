# ==============================================================================
# Environment Configuration Template for Harish Chintala Portfolio
# ==============================================================================
# Add these variables in Vercel: Project Settings -> Environment Variables.

# OPTION 1: Resend (RECOMMENDED for Vercel)
# Sign up at https://resend.com, generate a free API key, and paste it here.
# Free tier gives 3,000 emails/month, 100 emails/day, zero spam delay, never blocked.
# RESEND_API_KEY=re_123456789abcdef
# RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# OPTION 2: Web3Forms (Instant setup, 250 free emails/month)
# Go to https://web3forms.com, enter your email to get an Access Key instantly.
# WEB3FORMS_ACCESS_KEY=your-access-key-here

# OPTION 3: FormSubmit / Custom Form Endpoint
# Defaults automatically to FormSubmit (harishchintaladev@gmail.com).
# CONTACT_FORM_ENDPOINT=https://formsubmit.co/ajax/harishchintaladev@gmail.com
